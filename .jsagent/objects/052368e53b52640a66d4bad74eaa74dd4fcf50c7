27:         for (let channel = 0; channel < output.length; ++channel) {
28:             const outChannel = output[channel];
29:             for (let i = 0; i < outChannel.length; ++i) {
30:                 const white = Math.random() * 2 - 1;
31:                 this.b0 = 0.99886 * this.b0 + white * 0.0555179;
