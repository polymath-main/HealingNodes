class TrajectoryManager {
    constructor() {
        // V = [f_base, T_breath, alpha_noise, phi_color, harmonic_ratio, orbital_velocity, binaural_offset]
        this.currentState = {
            f_base: 33, 
            T_breath: 10, 
            alpha_noise: 1, 
            phi_color: 200, 
            harmonic_ratio: 1.5, 
            orbital_velocity: 0, 
            binaural_offset: 0 
        };
        this.targetState = { ...this.currentState };
        this.startTime = 0;
        this.duration = 0;
        this.intervalId = setInterval(() => this.tick(), 1000); // 1Hz Broadcaster
    }

    startTrajectory(target, durationMs) {
        this.targetState = { ...this.currentState, ...target };
        this.duration = durationMs || 1000; // default 1s fade if none
        this.startTime = Date.now();
        console.log(`[Trajectory Started] Morphing over ${this.duration}ms`);
    }

    tick() {
        const now = Date.now();
        let progress = this.duration === 0 ? 1 : (now - this.startTime) / this.duration;
        
        if (progress >= 1) {
            progress = 1;
        }

        // Apply smoothstep easing: 3x^2 - 2x^3
        const eased = progress * progress * (3 - 2 * progress);

        // Interpolate Vector V
        for (const key in this.currentState) {
            this.currentState[key] = this.lerp(this.currentState[key], this.targetState[key], eased);
        }

        this.broadcastState();
    }

    lerp(start, end, amt) {
        return (1 - amt) * start + amt * end;
    }

    broadcastState() {
        const N = nodes.length;
        
        io.emit('admin_state_update', { nodeCount: N, state: this.currentState });

        if (N === 0) return;
        const targetSyncTime = Date.now() + 2500; 

        nodes.forEach((id, index) => {
            const baseAngleRads = (2 * Math.PI * index) / N;
            io.to(id).emit('audio_state_update', {
                nodeCount: N,
                myIndex: index,
                baseAngleRads: baseAngleRads,
                targetSyncTime: targetSyncTime,
                v: this.currentState // The Environmental Vector
            });
        });
    }
}