{
  "name": "healingnodes-host",
  "version": "1.0.0",
  "description": "HealingNodes Native Host Broadcaster",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.polymath.healingnodes",
    "productName": "HealingNodes Host",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "client_dist/**/*"
    ]
  }
}
